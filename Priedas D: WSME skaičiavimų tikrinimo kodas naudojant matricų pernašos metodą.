import numpy as np
import math
import matplotlib.pyplot as plt
from itertools import product
import time

def logsumexp(arr):
    arr = np.asanyarray(arr)
    if arr.size == 0: return -np.inf
    m = np.nanmax(arr)
    if not np.isfinite(m) or np.all(np.isneginf(arr)): return -np.inf
    return m + math.log(np.sum(np.exp(arr - m)))

class WSME_TransferMatrix:
    def __init__(self, seka, hb, dg, s_liekanos_nuostolis, enma):
        self.seka = seka
        self.n = len(seka)
        self.R = 0.001987
        self.epsilon_matrica = self._sukurti_kontaktus_pagal_enma(hb, dg, enma)
        self.s_masyvas = np.full(self.n, s_liekanos_nuostolis)
        self._prieskaiciuoti_segmentus()

    def _sukurti_kontaktus_pagal_enma(self, hb, dg, enma):
        m = np.zeros((self.n, self.n))
        for i in range(self.n):
            for j in range(self.n):
                vertė = enma[i, j]
                if vertė != 0:
                    if vertė == 'hb': m[i, j] = hb
                    elif vertė == 'dg': m[i, j] = dg
                    elif vertė == 'hb+dg': m[i, j] = hb + dg
        return m + m.T

    def _prieskaiciuoti_segmentus(self):
        n = self.n
        self.E_kontaktu = np.zeros((n, n))
        self.S_suma = np.zeros((n, n))
        prefix_s = np.concatenate(([0.0], np.cumsum(self.s_masyvas)))
        for i in range(n):
            for j in range(i, n):
                E = 0.0
                for a in range(i, j + 1):
                    for b in range(a + 1, j + 1):
                        E += self.epsilon_matrica[a, b]
                self.E_kontaktu[i, j] = E
                self.S_suma[i, j] = prefix_s[j+1] - prefix_s[i]

    def deltaG_segmento(self, i, j, T):
        return self.E_kontaktu[i, j] - T * self.S_suma[i, j]

    def generuoti_Fn_profilį(self, T):
        beta = 1.0 / (self.R * T)
        n = self.n
        
        log_Z_U = np.full((n + 1, n + 1), -np.inf)
        log_Z_F = np.full((n + 1, n + 1), -np.inf)
        
        log_Z_U[0, 0] = 0.0

        for k in range(1, n + 1):
            for n_aa in range(k):
                log_Z_U[k, n_aa] = logsumexp([log_Z_U[k-1, n_aa], log_Z_F[k-1, n_aa]])
            
            for i in range(k):
                n_aa_segmente = k - i
                dg = self.deltaG_segmento(i, k - 1, T)
                
                for n_aa_iki in range(i + 1):
                    if np.isfinite(log_Z_U[i, n_aa_iki]):
                        n_aa_viso = n_aa_iki + n_aa_segmente
                        
                        terminas = log_Z_U[i, n_aa_iki] - beta * dg
                        
                        log_Z_F[k, n_aa_viso] = logsumexp([log_Z_F[k, n_aa_viso], terminas])

        logZ_profilis = np.full(n + 1, -np.inf)
        for n_aa in range(n + 1):
            logZ_profilis[n_aa] = logsumexp([log_Z_U[n, n_aa], log_Z_F[n, n_aa]])
        
        aminorugsciu_skaiciai = np.arange(n + 1)
        F_profilis = np.full_like(logZ_profilis, np.inf)
        valid_mask = np.isfinite(logZ_profilis)
        F_profilis[valid_mask] = -self.R * T * logZ_profilis[valid_mask]
        
        F_profilis -= F_profilis[0]
        
        return aminorugsciu_skaiciai, F_profilis


