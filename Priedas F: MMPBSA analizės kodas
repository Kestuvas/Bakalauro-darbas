def save_wsme_energies(protein_name, final_dir, residues, avg_energies, std_energies):
    output_file = os.path.join(final_dir, f'{protein_name}_WSME_energies.dat')
    with open(output_file, 'w') as f:
        f.write(f"# WSME sąveikų energijos - {protein_name}\n")
        f.write(f"# Sukurta: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"# Residų skaičius: {len(residues)}\n")
        f.write("# Residue    Avg_Energy(kcal/mol)    Std_Dev(kcal/mol)\n")
        for r, avg, std in zip(residues, avg_energies, std_energies):
            f.write(f"{r:8d}    {avg:12.4f}    {std:12.4f}\n")
    
    print(f"    WSME energijos išsaugotos: {output_file}")
    
    plt.figure(figsize=(14, 6))
    plt.bar(residues, avg_energies, yerr=std_energies, capsize=3, 
            color='skyblue', edgecolor='navy', alpha=0.7,
            error_kw={'elinewidth': 1, 'ecolor': 'red'})
    plt.axhline(0, color='black', linewidth=1, linestyle='-', alpha=0.5)
    plt.xlabel('Aminorūgšties indeksas')
    plt.ylabel('Sąveikos energija (kcal/mol)')
    plt.title(f'{protein_name} - Aminorūgščių sąveikų energijos profilis')
    plt.grid(axis='y', alpha=0.3, linestyle='--')
    plt.tight_layout()
    plt.savefig(os.path.join(final_dir, f'{protein_name}_WSME_energy_profile.png'), dpi=150, bbox_inches='tight')
    plt.close()
    print(f"    WSME profilis išsaugotas: {os.path.join(final_dir, f'{protein_name}_WSME_energy_profile.png')}")
    return output_file

def run_combined_pca(protein_name, final_dir, stripped_trajs, dry_prmtop):
    print(f"    Vykdoma JUNGTINĖ PCA analizė (visos replikos kartu)...")
    
    combined_pca_dir = os.path.join(final_dir, "combined_pca")
    ensure_dir(combined_pca_dir)
    
    rel_prmtop = os.path.relpath(dry_prmtop, combined_pca_dir)
    
    cpptraj_in = os.path.join(combined_pca_dir, "combined_pca.in")
    
    with open(cpptraj_in, 'w') as f:
        f.write(f"parm {rel_prmtop}\n")
        
        for traj in stripped_trajs:
            rel_traj = os.path.relpath(traj, combined_pca_dir)
            f.write(f"trajin {rel_traj}\n")
            
        f.write(f"""
autoimage
rms FitToFirst @CA first

matrix covar name combined_covar @CA
run

runanalysis diagmatrix combined_covar vecs 2 out pca_modes.dat
quit
""")
    print("      Skaičiuojamos PCA modos...")
    result = subprocess.run([CPPTRAJ_CMD, "-i", "combined_pca.in"], 
                           cwd=combined_pca_dir, capture_output=True, text=True)
    
    if result.returncode != 0:
        print(f"    Jungtinės PCA klaida (Modes): {result.stderr[:200]}")
        return None

    cpptraj_proj = os.path.join(combined_pca_dir, "combined_pca_proj.in")
    with open(cpptraj_proj, 'w') as f:
        f.write(f"parm {rel_prmtop}\n")
        
        for traj in stripped_trajs:
            rel_traj = os.path.relpath(traj, combined_pca_dir)
            f.write(f"trajin {rel_traj}\n")
            
        f.write(f"""
autoimage
rms FitToFirst @CA first

projection proj_all evecs pca_modes.dat out combined_pca_proj.dat beg 1 end 2 @CA
run
quit
""")
    
    print("      Vykdoma projekcija...")
    result_proj = subprocess.run([CPPTRAJ_CMD, "-i", "combined_pca_proj.in"], 
                                cwd=combined_pca_dir, capture_output=True, text=True)
    
    if result_proj.returncode != 0:
        print(f"    Jungtinės PCA klaida (Projection): {result_proj.stderr[:200]}")
        return None


    full_data_path = os.path.join(combined_pca_dir, "combined_pca_proj.dat")
    if os.path.exists(full_data_path):
        return full_data_path
    return None

def plot_combined_pca(protein_name, final_dir, combined_data_file, n_replicas):
    if not combined_data_file: return

    try:
        df = pd.read_csv(combined_data_file, sep=r'\s+', comment='#')
        
        total_frames = len(df)
        frames_per_replica = total_frames // n_replicas
        
        fig, ax = plt.subplots(figsize=(10, 8))
        colors = plt.cm.viridis(np.linspace(0, 1, n_replicas))
        
        for i in range(n_replicas):
            start_idx = i * frames_per_replica
            end_idx = (i + 1) * frames_per_replica
            
            subset = df.iloc[start_idx:end_idx]
            
            ax.scatter(subset.iloc[::10, 1], subset.iloc[::10, 2], 
                      s=10, alpha=0.6, color=colors[i], label=f'Replika {i+1}')
            
            if not subset.empty:
                ax.scatter(subset.iloc[0, 1], subset.iloc[0, 2], s=100, marker='^', 
                          edgecolor='black', color=colors[i], zorder=10)
                ax.scatter(subset.iloc[-1, 1], subset.iloc[-1, 2], s=100, marker='s', 
                          edgecolor='black', color=colors[i], zorder=10)

        ax.set_title(f'{protein_name} - Jungtinė PCA (Teisingas palyginimas)')
        ax.set_xlabel('PC1 (Bendras judesys)')
        ax.set_ylabel('PC2 (Bendras judesys)')
        ax.legend()
        ax.grid(alpha=0.3)
        
        out_file = os.path.join(final_dir, f'{protein_name}_COMBINED_PCA.png')
        plt.savefig(out_file, dpi=150, bbox_inches='tight')
        print(f"    Jungtinis PCA grafikas išsaugotas: {os.path.basename(out_file)}")
        plt.close()
            
    except Exception as e:
        print(f"    Klaida piešiant jungtinį PCA: {e}")

def process_protein(protein_name, simulation_dirs):
    print(f"\n{'='*50}")
    print(f" ANALIZUOJAMAS: {protein_name}")
    print(f"{'='*50}")
    
    final_dir = os.path.join(OUTPUT_ROOT, protein_name)
    temp_dir = os.path.join(final_dir, "tarpiniai_failai")
    ensure_dir(final_dir)
    ensure_dir(temp_dir)
    
    data = {
        'thermo_dfs': [],
        'rmsd_files': [],
        'pca_files': [],
        'mmpbsa_energies': [],
        'stripped_trajs': [],
        'dry_prmtop': None
    }
    
    n_res_detected = 0
    
    for i, sim_dir in enumerate(simulation_dirs):
        replica_id = i + 1
        sim_work_dir = os.path.join(sim_dir, protein_name)
        
        if not os.path.isdir(sim_work_dir):
            continue
        
        print(f"\n  Replika {replica_id}:")
        
        prmtop = os.path.join(sim_work_dir, f"{protein_name}_solvated.prmtop")
        mdcrd = os.path.join(sim_work_dir, "prod.mdcrd")
        mdout = os.path.join(sim_work_dir, "prod.out")
        protonated_pdb = os.path.join(sim_work_dir, f"{protein_name}_protonated.pdb")
        
        if not os.path.exists(prmtop) or not os.path.exists(mdcrd):
            print(f"    Trūksta failų! Praleidžiama.")
            continue
        
        if n_res_detected == 0 and os.path.exists(protonated_pdb):
            n_res_detected = get_residue_count_from_pdb(protonated_pdb)
            print(f"    Iš PDB nustatyta residuų: {n_res_detected}")
        
        if os.path.exists(mdout):
            df_thermo = parse_mdout_thermo(mdout)
            if not df_thermo.empty:
                data['thermo_dfs'].append(df_thermo)
                print(f"    Termodinamika: {len(df_thermo)} taškų")
        
        rmsd_file, pca_file, stripped_traj, dry_top = run_cpptraj_analysis(
            prmtop, mdcrd, temp_dir, replica_id, protein_name
        )
        
        if rmsd_file and os.path.exists(rmsd_file):
            data['rmsd_files'].append(rmsd_file)
            print(f"    RMSD: OK - {os.path.basename(rmsd_file)}")
        else:
            print(f"    KLAIDA: RMSD failas neegzistuoja!")
        
        if pca_file and os.path.exists(pca_file):
            data['pca_files'].append(pca_file)
            print(f"    PCA: OK - {os.path.basename(pca_file)}")
        else:
            print(f"    KLAIDA: PCA failas neegzistuoja!")
        
        if stripped_traj and os.path.exists(stripped_traj):
            data['stripped_trajs'].append(stripped_traj)
        
        if dry_top and os.path.exists(dry_top) and data['dry_prmtop'] is None:
            data['dry_prmtop'] = dry_top
        
        if n_res_detected > 0 and n_res_detected < 1000 and MMPBSA_CMD:
            csv_file = run_mmpbsa_decomp(
                prmtop, mdcrd, temp_dir, replica_id, n_res_detected, protein_name
            )
            if csv_file:
                df_energies = parse_mmpbsa_residue_energies(csv_file)
                if df_energies is not None and len(df_energies) > 0:
                    data['mmpbsa_energies'].append(df_energies)
                    print(f"    MMPBSA: {len(df_energies)} residues")
    
    if not data['thermo_dfs'] and not data['rmsd_files']:
        print(f"\n  [!] Nėra duomenų {protein_name}")
        return
    
    print(f"\n  Generuojami grafikai...")
    plot_results(protein_name, final_dir, data, n_res_detected)
    
    if data['pca_files']:
        plot_pca_convergence(protein_name, final_dir, data['pca_files'])
    
    if data['mmpbsa_energies']:
        print(f"\n  Apdorojamos MMPBSA energijos ({len(data['mmpbsa_energies'])} replikos)...")
        all_residues = set()
        for df in data['mmpbsa_energies']:
            all_residues.update(df['Residue'].values)
        
        common_residues = sorted(all_residues)
        print(f"    Bendri residai ({len(common_residues)}): {common_residues[:10]}...")
        
        if len(common_residues) > 0:
            energy_matrix = []
            for df in data['mmpbsa_energies']:
                en_dict = dict(zip(df['Residue'], df['Energy']))
                energies = [en_dict.get(res, np.nan) for res in common_residues]
                energy_matrix.append(energies)
            
            energy_matrix = np.array(energy_matrix)
            avg_energies = np.nanmean(energy_matrix, axis=0)
            std_energies = np.nanstd(energy_matrix, axis=0)
            
            save_wsme_energies(protein_name, final_dir, common_residues, avg_energies, std_energies)
    else:
        print(f"\n  [!] Nėra MMPBSA energijų duomenų WSME profiliui!")
        
    if len(data['stripped_trajs']) > 1 and data['dry_prmtop']:
        combined_pca_file = run_combined_pca(protein_name, final_dir, 
                                           data['stripped_trajs'], data['dry_prmtop'])
        if combined_pca_file:
            plot_combined_pca(protein_name, final_dir, combined_pca_file, len(data['stripped_trajs']))
    
    print(f"\n   {protein_name} analizė baigta!")
    print(f"  Rezultatai: {final_dir}")

def main():
    print("="*70)
    print(" MD SIMULIACIJŲ ANALIZĖS SKRIPTAS (VEIKIANTI VERSIJA)")
    print("="*70)
    
    sim_dirs = sorted(glob.glob(os.path.join(BASE_DIR, "amber_simulations_output_*")))
    if not sim_dirs:
        print("Klaida: Nerasta amber_simulations_output_* direktorijų!")
        return
    
    print(f"Rastos simuliacijų direktorijos ({len(sim_dirs)}):")
    for d in sim_dirs:
        print(f"  - {os.path.basename(d)}")
    
    proteins = []
    for d in sim_dirs:
        for item in os.listdir(d):
            item_path = os.path.join(d, item)
            if os.path.isdir(item_path):
                if os.path.exists(os.path.join(item_path, f"{item}_solvated.prmtop")) and \
                   os.path.exists(os.path.join(item_path, "prod.mdcrd")):
                    if item not in proteins:
                        proteins.append(item)
    
    proteins.sort()
    print(f"\nRasti baltymai ({len(proteins)}):")
    for i, p in enumerate(proteins[:20]):
        print(f"  {i+1:2d}. {p}")
    if len(proteins) > 20:
        print(f"  ... ir dar {len(proteins)-20}")
    
    print(f"\nIšvesties direktorija: {OUTPUT_ROOT}")
    print("="*70)
    
    print(f"\nPradedama visų {len(proteins)} baltymų analizė...")
    
    for prot in proteins:
        print(f"\n{'='*50}")
        print(f" Pradedamas: {prot}")
        print(f"{'='*50}")
        try:
            process_protein(prot, sim_dirs)
        except KeyboardInterrupt:
            print("\n\nAnalizė nutraukta vartotojo!")
            break
        except Exception as e:
            print(f"\nKlaida apdorojant {prot}: {e}")
            import traceback
            traceback.print_exc()
            continue
    
    print("\n" + "="*70)
    print(" VISI DARBAI BAIGTI!")
    print(f" Rezultatai: {OUTPUT_ROOT}")
    print("="*70)

if __name__ == "__main__":
    main()
