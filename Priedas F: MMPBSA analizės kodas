def ensure_dir(path):
    if not os.path.exists(path):
        os.makedirs(path)

def parse_mdout_thermo(mdout_file):
    data = {'TIME': [], 'TEMP': [], 'Density': [], 'EPtot': [], 'EKtot': [], 'Etot': []}
    patterns = {
        'TIME': re.compile(r"TIME\(PS\)\s*=\s*([0-9\.]+)"),
        'TEMP': re.compile(r"TEMP\(K\)\s*=\s*([0-9\.]+)"),
        'Density': re.compile(r"Density\s*=\s*([0-9\.]+)"),
        'EPtot': re.compile(r"EPtot\s*=\s*([0-9\.\-]+)"),
        'EKtot': re.compile(r"EKtot\s*=\s*([0-9\.\-]+)"),
        'Etot': re.compile(r"Etot\s*=\s*([0-9\.\-]+)")
    }
    try:
        with open(mdout_file, 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                for key, pattern in patterns.items():
                    match = pattern.search(line)
                    if match:
                        data[key].append(float(match.group(1)))
        min_len = min(len(v) for v in data.values() if len(v) > 0)
        if min_len == 0:
            return pd.DataFrame()
        return pd.DataFrame({k: v[:min_len] for k, v in data.items() if len(v) > 0})
    except Exception as e:
        print(f"    Klaida skaitant {mdout_file}: {e}")
        return pd.DataFrame()

def run_cpptraj_analysis(solvated_prmtop, trajectory, temp_dir, replica_id, protein_name):
    rmsd_file = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_rmsd.dat")
    pca_modes = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_pca_modes.dat")
    pca_proj = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_pca_proj.dat")
    stripped_traj = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_stripped.nc")
    dry_prmtop = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_dry.prmtop")
    
    print(f"      Generuojamas RMSD failas: {os.path.basename(rmsd_file)}")
    print(f"      Generuojamas PCA projekcijos failas: {os.path.basename(pca_proj)}")
    
    if not create_dry_topology(solvated_prmtop, dry_prmtop, temp_dir):
        print(f"      KLAIDA: Nepavyko sukurti dry topologijos")
        return None, None
    
    rel_prmtop = os.path.relpath(solvated_prmtop, temp_dir)
    rel_traj = os.path.relpath(trajectory, temp_dir)
    
    script_strip = f"""parm {rel_prmtop}
trajin {rel_traj} {CPPTRAJ_INTERVAL}
strip :WAT,Na+,Cl-
trajout {os.path.basename(stripped_traj)} netcdf
run
quit
"""
    script_strip_path = os.path.join(temp_dir, f"cpptraj_strip_R{replica_id}.in")
    with open(script_strip_path, 'w') as f:
        f.write(script_strip)
    
    result_strip = subprocess.run([CPPTRAJ_CMD, "-i", os.path.basename(script_strip_path)], 
                                  cwd=temp_dir, 
                                  capture_output=True,
                                  text=True)
    
    if result_strip.returncode != 0:
        print(f"      CPPTRAJ strip klaida: {result_strip.stderr[:500]}")
        return None, None
    
    if not os.path.exists(stripped_traj):
        print(f"      KLAIDA: Stripinta trajektorija nesukurta!")
        return None, None
    
    rel_dry_prmtop = os.path.relpath(dry_prmtop, temp_dir)
    rel_stripped_traj = os.path.basename(stripped_traj)
    
    script_analysis = f"""parm {rel_dry_prmtop}
trajin {rel_stripped_traj}
autoimage
rms ToFirst @CA first out {os.path.basename(rmsd_file)} time 1
matrix covar name covmat @CA
run
analyze matrix covmat vecs 2 out {os.path.basename(pca_modes)}
run
projection proj @CA evecs {os.path.basename(pca_modes)} out {os.path.basename(pca_proj)} beg 1 end 2
run
quit
"""
    script_analysis_path = os.path.join(temp_dir, f"cpptraj_analysis_R{replica_id}.in")
    with open(script_analysis_path, 'w') as f:
        f.write(script_analysis)
    
    result_analysis = subprocess.run([CPPTRAJ_CMD, "-i", os.path.basename(script_analysis_path)],
                                     cwd=temp_dir,
                                     capture_output=True,
                                     text=True)
    
    if result_analysis.returncode != 0:
        print(f"      CPPTRAJ analizės klaida: {result_analysis.stderr[:500]}")
        return run_cpptraj_analysis_alt(dry_prmtop, stripped_traj, temp_dir, replica_id, protein_name, rmsd_file, pca_modes, pca_proj)
    
    if os.path.exists(rmsd_file):
        size = os.path.getsize(rmsd_file)
        print(f"      RMSD failas sukurtas: {size} baitų")
    else:
        print(f"      KLAIDA: RMSD failas nesukurtas!")
        
    if os.path.exists(pca_proj):
        size = os.path.getsize(pca_proj)
        print(f"      PCA projekcijos failas sukurtas: {size} baitų")
    else:
        print(f"      KLAIDA: PCA projekcijos failas nesukurtas!")
    
    return rmsd_file, pca_proj, stripped_traj, dry_prmtop

def run_cpptraj_analysis_alt(dry_prmtop, stripped_traj, temp_dir, replica_id, protein_name, rmsd_file, pca_modes, pca_proj):
    print(f"      Bandome alternatyvų PCA metodą...")
    
    script_alt = f"""parm {os.path.relpath(dry_prmtop, temp_dir)}
trajin {os.path.basename(stripped_traj)}
autoimage
rms ToFirst @CA first out {os.path.basename(rmsd_file)} time 1
matrix covar name covmat @CA
run
diagmatrix covmat vecs 2 out {os.path.basename(pca_modes)}
run
projection proj @CA modes 1,2 out {os.path.basename(pca_proj)}
run
quit
"""
    script_alt_path = os.path.join(temp_dir, f"cpptraj_alt_R{replica_id}.in")
    with open(script_alt_path, 'w') as f:
        f.write(script_alt)
    
    result_alt = subprocess.run([CPPTRAJ_CMD, "-i", os.path.basename(script_alt_path)],
                                cwd=temp_dir,
                                capture_output=True,
                                text=True)
    
    if result_alt.returncode != 0:
        print(f"      Alternatyvus metodas taip pat nepavyko: {result_alt.stderr[:200]}")
        return None, None, None, None
    
    return rmsd_file, pca_proj, stripped_traj, dry_prmtop
    
def create_dry_topology(solvated_prmtop, dry_prmtop_out, work_dir):
    try:
        import parmed as pmd
        parm = pmd.load_file(solvated_prmtop)
        parm.strip(':WAT,Na+,Cl-')
        parm.save(dry_prmtop_out, overwrite=True)
        return os.path.exists(dry_prmtop_out)
    except Exception as e:
        print(f"    parmed klaida: {e}")
        return False

def parse_mmpbsa_residue_energies(csv_file):
    try:
        print(f"    Skaitomas MMPBSA failas: {os.path.basename(csv_file)}")
        
        with open(csv_file, 'r') as f:
            lines = f.readlines()
        
        data_lines = lines[8:]
        
        energy_sums = {}
        pair_count = 0
        
        for line in data_lines:
            line = line.strip()
            if not line:
                continue
            
            parts = line.split(',')
            if len(parts) < 18:  
                continue
            
            try:
                res1_str = parts[0].strip()
                res2_str = parts[1].strip()
                
                res1_match = re.search(r'(\d+)', res1_str)
                res2_match = re.search(r'(\d+)', res2_str)
                
                if res1_match and res2_match:
                    res1 = int(res1_match.group(1))
                    res2 = int(res2_match.group(1))
                    
                    try:
                        total_energy = float(parts[17])
                        pair_count += 1
                        
                        if res1 not in energy_sums:
                            energy_sums[res1] = 0.0
                        energy_sums[res1] += total_energy
                        
                        if res1 != res2:
                            if res2 not in energy_sums:
                                energy_sums[res2] = 0.0
                            energy_sums[res2] += total_energy
                            
                    except (ValueError, TypeError):
                        continue
            except:
                continue
        
        print(f"    Apdorota {pair_count} porų")
        
        if energy_sums:
            residues = sorted(energy_sums.keys())
            energies = [energy_sums[r] for r in residues]
            
            df_result = pd.DataFrame({'Residue': residues, 'Energy': energies})
            
            print(f"    Išgauta {len(residues)} residuų energijų")
            print(f"    Energijos diapazonas: {min(energies):.2f} - {max(energies):.2f} kcal/mol")
            
            return df_result
        else:
            print(f"    KLAIDA: Neišgauta nė vieno resid energijos")
            return None
        
    except Exception as e:
        print(f"    MMPBSA nuskaitymo klaida: {e}")
        import traceback
        traceback.print_exc()
        return None

def run_mmpbsa_decomp(prmtop, trajectory, temp_dir, replica_id, n_res, protein_name):
    csv_out = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_mmpbsa.csv")
    stats_out = os.path.join(temp_dir, f"{protein_name}_R{replica_id}_mmpbsa_stats.dat")
    
    if os.path.exists(csv_out) and os.path.getsize(csv_out) > 1000:
        print(f"    MMPBSA rezultatas jau egzistuoja")
        return csv_out
    
    mmpbsa_work_dir = os.path.join(temp_dir, f"mmpbsa_work_R{replica_id}")
    ensure_dir(mmpbsa_work_dir)
    
    shutil.copy2(prmtop, os.path.join(mmpbsa_work_dir, "solvated.prmtop"))
    
    if not os.path.exists(os.path.join(mmpbsa_work_dir, "traj.nc")):
        os.symlink(trajectory, os.path.join(mmpbsa_work_dir, "traj.nc"))
    
    proper_dry_prmtop = os.path.join(mmpbsa_work_dir, "dry.prmtop")
    if not create_dry_topology(prmtop, proper_dry_prmtop, mmpbsa_work_dir):
        print("    KLAIDA: Nepavyko sukurti dry topologijos")
        return None
    
    mmpbsa_in = os.path.join(mmpbsa_work_dir, "mmpbsa.in")
    with open(mmpbsa_in, 'w') as f:
        f.write(f"""&general
   interval={MMPBSA_INTERVAL}, netcdf=1, verbose=0,
   keep_files=0,
/
&gb
   igb=5, saltcon=0.150,
/
&decomp
   idecomp=4, dec_verbose=0,
   print_res="1-{n_res}"
/
""")
    
    cmd = [
        MMPBSA_CMD, "-O",
        "-i", "mmpbsa.in",
        "-cp", "dry.prmtop",
        "-y", "traj.nc",
        "-sp", "solvated.prmtop",
        "-do", os.path.basename(csv_out),
        "-o", "mmpbsa_stats.dat"
    ]
    
    print(f"    Paleidžiama MMPBSA ({n_res} residues, idecomp=4)...")
    
    try:
        proc = subprocess.run(cmd, cwd=mmpbsa_work_dir, 
                             capture_output=True,
                             text=True, timeout=3600)
        
        if proc.returncode != 0:
            print(f"    MMPBSA klaida: {proc.stderr[-500:]}")
            with open(os.path.join(temp_dir, f"mmpbsa_error_R{replica_id}.log"), 'w') as f:
                f.write(proc.stderr)
            return None
        
        src_csv = os.path.join(mmpbsa_work_dir, os.path.basename(csv_out))
        if os.path.exists(src_csv):
            shutil.copy2(src_csv, csv_out)
            size_kb = os.path.getsize(csv_out) / 1024
            print(f"    MMPBSA baigta: {size_kb:.1f} KB")
            return csv_out
        else:
            print(f"    KLAIDA: MMPBSA nesukūrė CSV failo")
            return None
            
    except subprocess.TimeoutExpired:
        print("    MMPBSA timeout (1h)")
    except Exception as e:
        print(f"    MMPBSA klaida: {e}")
    
    return None

def get_residue_count_from_pdb(pdb_file):
    try:
        residues = set()
        with open(pdb_file, 'r') as f:
            for line in f:
                if line.startswith('ATOM') and line[17:20].strip() not in ['HOH', 'WAT']:
                    res_num = line[22:26].strip()
                    if res_num:
                        residues.add(int(res_num))
        return len(residues)
    except:
        return 0

