 OUTLIER SECES: Blogiausi: {blogiausi_sarasas}")
    
    istorija.append({
        'iteracija': iteracija,
        'rmse': tikras_rmse_total,
        'koreliacija': r_val,
        'alpha_vdw': params[0],
        'alpha_el': params[1],    
        'alpha_pol': params[2],   
        'alpha_npol': params[3],
        'beta_vdw': params[4],    
        'disulfido_e': params[5], 
