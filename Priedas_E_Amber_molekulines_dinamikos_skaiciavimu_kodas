import os
import subprocess
import glob
import datetime
import re
import shutil
import time
import sys
import multiprocessing

MAIN_OUTPUT_DIR = f"amber_simulations_output_{datetime.date.today().strftime('%Y-%m-%d')}"
TARGET_PH = 7.4
IONIC_STRENGTH = 0.150
FORCE_FIELD = "leaprc.protein.ff19SB"
WATER_MODEL = "tip3p"
WATER_BOX_TYPE = "TIP3PBOX"
BOX_BUFFER = 12.0

AVAILABLE_GPUS = [0, 1]

